# Infra cluster config — for disk-server.yml and individual playbooks.
# Copy to local.env and fill in your values. Gitignored.
#
# Usage:
#   cp local.env.example local.env
#   vi local.env
#   cd deploy/ansible && ansible-playbook disk-server.yml -e @../../local.env
#   cd deploy/ansible && ansible-playbook prepare-disks.yml -e @../../local.env -e disk_source_mode=s3

# Kubeconfig with cluster-admin access to the infra cluster
# k8s_kubeconfig: ~/secrets/fvmw-mgmt.kubeconfig

# Infra cluster apps domain
cluster_domain: apps.cluster.example.com

# Namespace for fvmw resources
fvmw_namespace: fvmw

# Shared PVC storage class (must support ReadWriteMany, e.g. CephFS)
# storage_class: ocs-storagecluster-cephfs

# Source vCenter for VMDK export (used by disk-server.yml)
source_vcenter_url: https://vcenter.example.com/sdk
source_vcenter_user: Administrator@vsphere.local
source_vcenter_password: changeme

# VM disk catalog (used by disk export/download and DataVolume metadata)
fvmw_vm_disks:
  - name: database
    source_vm_path: "/RS00/vm/Roadshow/database"
    source_folder: "Roadshow"
    flat_vmdk_http_paths:
      - "database.vmdk"
      - "database-flat.vmdk"
    datavolume_s3_url: "s3://vm-disks"
  - name: winweb01
    source_vm_path: "/RS00/vm/Roadshow/winweb01"
    source_folder: "Roadshow"
    flat_vmdk_http_paths:
      - "winweb01.vmdk"
      - "winweb01-flat.vmdk"
    datavolume_s3_url: "s3://vm-disks"
  - name: winweb02
    source_vm_path: "/RS00/vm/Roadshow/winweb02"
    source_folder: "Roadshow"
    flat_vmdk_http_paths:
      - "winweb02.vmdk"
      - "winweb02-flat.vmdk"
    datavolume_s3_url: "s3://vm-disks"
  - name: haproxy
    source_vm_path: "/RS00/vm/Roadshow/haproxy-user1"
    source_folder: "Roadshow"
    flat_vmdk_http_paths:
      - "haproxy.vmdk"
      - "haproxy-flat.vmdk"
    datavolume_s3_url: "s3://vm-disks"

# Generic S3 auth values for DataVolume imports
fvmw_datavolume_s3_secret_name: fvmw-s3-auth
fvmw_datavolume_s3_access_key_id: changeme
fvmw_datavolume_s3_secret_key: changeme
# Optional S3 tuning for prepare-disks.yml
# fvmw_datavolume_s3_region: us-east-1
# fvmw_datavolume_s3_endpoint_url: https://s3.example.com
# fvmw_datavolume_s3_signature_v2: true
# IBM COS tip:
#   datavolume_s3_url can be either:
#     s3://<bucket>/<optional-prefix>
#   or endpoint-style:
#     s3://s3.<region>.cloud-object-storage.appdomain.cloud/<bucket>/<optional-prefix>
#   and optionally set:
#     fvmw_datavolume_s3_region: us-standard
#     fvmw_datavolume_s3_signature_v2: true

# Optional HTTP disk server mode for prepare-disks.yml
# disk_source_url: https://fvmw-disks.apps.cluster.example.com

# --- Below only needed for individual playbooks (not disk-server.yml) ---

# Container image (use internal registry after build.yml)
fvmw_image: image-registry.openshift-image-registry.svc:5000/fvmw/fvmw:latest

# Shared password for all generated users (user1..userN)
fvmw_password: changeme

# GitHub token for private repo access
# github_token: "{{ lookup('pipe', 'gh auth token') }}"

# Number of users to provision (user1..userN)
fvmw_num_users: 60

# Number of fvmw pod replicas. At scale (many concurrent Provider inventory
# syncs + parallel MTV migrations), a single pod running at the default
# 500m/512Mi resources gets CPU-throttled. Tested with 20 concurrent users
# (60 VMs migrating in parallel): 2 replicas already avoids most throttling,
# 6 gives comfortable headroom without over-reserving cluster CPU that MTV's
# virt-v2v conversion pods also need.
fvmw_replicas: 6
